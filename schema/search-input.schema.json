{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nawashiro.github.io/chiyoda_city_main_facilities/schema/search-input.schema.json",
  "title": "OSM search input",
  "type": "object",
  "required": ["source", "queries"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["kind", "sourceId", "retrievedAt"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["human", "source"]},
        "sourceId": {"type": ["string", "null"]},
        "retrievedAt": {"type": ["string", "null"]}
      }
    },
    "queries": {"type": "array", "items": {"$ref": "#/$defs/query"}}
  },
  "$defs": {
    "query": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {"type": "string", "minLength": 1},
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"}
      },
      "oneOf": [
        {"required": ["coordinates"], "not": {"required": ["qid"]}},
        {"required": ["qid"], "not": {"required": ["coordinates"]}}
      ]
    }
  }
}
